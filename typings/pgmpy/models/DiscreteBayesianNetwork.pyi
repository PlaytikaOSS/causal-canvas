from collections.abc import Hashable, Iterable
from typing import Any

import pandas as pd

from pgmpy.factors.discrete import TabularCPD
from pgmpy.parameter_estimator.base import DiscreteParameterEstimator

class DiscreteBayesianNetwork:
    cpds: list[TabularCPD]
    def __init__(self, ebunch: Iterable[tuple[Hashable, Hashable]] | None = ...) -> None: ...
    def add_node(self, node: Hashable) -> None: ...
    def add_nodes_from(self, nodes: Iterable[Hashable]) -> None: ...
    def add_edges_from(self, ebunch: Iterable[tuple[Hashable, Hashable]]) -> None: ...
    def remove_edge(self, u: Hashable, v: Hashable) -> None: ...
    def nodes(self) -> Any: ...
    def edges(self) -> Any: ...
    def get_parents(self, node: Hashable) -> list[Any]: ...
    def add_cpds(self, *cpds: TabularCPD) -> None: ...
    def remove_cpds(self, *cpds: TabularCPD | Hashable) -> None: ...
    def get_cpds(self, node: Hashable | None = ...) -> Any: ...
    def check_model(self) -> bool: ...
    def fit(
        self,
        data: pd.DataFrame,
        estimator: DiscreteParameterEstimator | None = ...,
        sample_weight: Any = ...,
    ) -> DiscreteBayesianNetwork: ...
